{
  "name": "prestige",
  "version": "0.2.0",
  "description": "Unique value store: a key-value store that keeps one physical copy of every unique value (exact SHA-256 or semantic embedding dedup), with TTL, LRU eviction and ML dataset deduplication. Local, RocksDB-backed.",
  "homepage": "https://github.com/demajh/prestige",
  "license": "Apache-2.0",
  "skill": "https://raw.githubusercontent.com/demajh/prestige/main/skill.md",
  "install": {
    "python": "pip install prestige-uvs",
    "import": "prestige",
    "source": "git clone https://github.com/demajh/prestige.git && cd prestige/python && pip install ."
  },
  "capabilities": ["exact-dedup", "semantic-dedup", "text-normalization", "ttl", "lru-eviction", "health-stats", "decision-records", "candidates", "value-metadata", "outcome-reports", "http-server", "ml-dataloaders"],
  "runtime": {"network": false, "account": false, "storage": "local directory (RocksDB)"},
  "docs": {
    "python": "https://github.com/demajh/prestige/blob/main/docs/python-bindings.md",
    "cache": "https://github.com/demajh/prestige/blob/main/docs/cache-semantics.md",
    "semantic": "https://github.com/demajh/prestige/blob/main/docs/semantic-dedup.md",
    "dataloaders": "https://github.com/demajh/prestige/blob/main/docs/dataloaders.md",
    "server": "https://github.com/demajh/prestige/blob/main/docs/server.md",
    "provenance": "https://github.com/demajh/prestige/blob/main/docs/provenance.md",
    "candidates": "https://github.com/demajh/prestige/blob/main/docs/candidates.md"
  }
}
